{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm --filter @aica/shared build && pnpm --filter @aica/web build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://aica-backend.onrender.com/api/v1/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
