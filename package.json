{
  "name": "ai-code-evolution-lab",
  "version": "1.0.0",
  "private": true,
  "description": "AI Code Evolution Lab — Collaborative & Pedagogical Code Evaluation Platform",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "vitest run",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "start:api": "node apps/api/dist/index.js",
    "start:worker": "node apps/worker/dist/index.js",
    "start:render": "node apps/worker/dist/index.js & node apps/api/dist/index.js",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mongoose": "^5.11.97",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.14.0"
}
